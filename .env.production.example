# Production environment for a single-VPS, same-origin deployment: Nginx at
# the edge, uvicorn behind it at /api, SQLite on local disk. See DEPLOY.md and
# CLAUDE.md → "Security & Runtime Hardening" for the reasoning behind each
# group. Copy to backend/.env and fill in every REQUIRED value — the boot
# guard (api/main.py#_verify_production_config) refuses to start with
# COOKIE_SECURE=true and any of them left at their dev default.

# ── Database ──────────────────────────────────────────────────────────────
# Empty => local SQLite (backend/fleet.db). Stays empty on the VPS plan of
# record — see the "Database" note in CLAUDE.md for why Postgres would be a
# regression here, not an upgrade. Only set this for a Postgres migration
# triggered by measured `db.sqlite_busy` events (§8.8), never by default.
DATABASE_URL=

# ── Auth / JWT ────────────────────────────────────────────────────────────
# REQUIRED. Long random secret — a guessable one lets anyone forge a
# super_admin token. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_DAYS=14
JWT_TTL_DAYS_SHORT=1

# ── Session cookie ────────────────────────────────────────────────────────
# REQUIRED true in production — this is what the boot guard checks for.
COOKIE_SECURE=true
COOKIE_NAME=bcr_session
# "strict" ships with the CSRF Origin check (api/middleware.py#CSRFOriginMiddleware)
# — do not loosen this without also revisiting that middleware.
COOKIE_SAMESITE=strict
# Empty => host-only cookie (correct for same-origin Nginx). Only set this if
# the frontend and API are deliberately on different subdomains.
COOKIE_DOMAIN=

# ── First-run bootstrap admin ────────────────────────────────────────────
# REQUIRED in production — the boot guard refuses to start without both, so a
# public instance can never fall back to a default admin/admin account. Only
# used once, on a genuinely empty database (services/auth_service.py
# ensure_bootstrap_admin); change the password immediately after first login.
BOOTSTRAP_ADMIN_USER=
BOOTSTRAP_ADMIN_PASSWORD=

# ── Password / lockout policy ────────────────────────────────────────────
PASSWORD_MIN_LENGTH=10
MAX_LOGIN_FAILURES=5
LOCKOUT_MINUTES=15
LOCKOUT_MAX_MINUTES=240
GLOBAL_LOGIN_FAILURES_THRESHOLD=20
GLOBAL_LOGIN_DELAY_SECONDS=2.0
RESET_TOKEN_TTL_MINUTES=30
RESET_MAX_PER_HOUR=5

# ── Origins ───────────────────────────────────────────────────────────────
# Same-origin deployment: the frontend is served BY Nginx at "/", so this is
# just your public domain, once. app_base_url falls back to the first
# cors_origins entry when unset.
APP_BASE_URL=https://your-domain.example
CORS_ORIGINS=https://your-domain.example
# MUST be false in production — this is the desktop launcher's LAN-mode
# escape hatch, and the boot guard refuses to start with it set alongside
# COOKIE_SECURE=true. Never set this on a public host.
CORS_ALLOW_LAN=false

# ── Proxy trust ───────────────────────────────────────────────────────────
# MUST ship together with the Nginx config below — see the nginx/ directory's
# `proxy_set_header X-Forwarded-For $remote_addr;` line. TRUE without Nginx
# actually setting that header lets any client spoof its own IP and skip
# every per-IP control (rate limiting, lockout). FALSE behind Nginx collapses
# every real visitor into one shared bucket (the proxy's own address).
TRUST_PROXY=true

# ── Rate limiting (L1-L3) — DOCUMENTATION.md §8.3 ────────────────────────
# Provisional defaults below are generous on purpose; replace with numbers
# measured from your own traffic via /internal/stats (§8.7/§8.10), not
# guesses. Leave RATE_LIMIT_ENABLED=true.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IP_PER_MIN=300
RATE_LIMIT_IP_BURST=60
RATE_LIMIT_ACCOUNT_PER_MIN=240
RATE_LIMIT_ACCOUNT_BURST=40
RATE_LIMIT_CHEAP_PER_MIN=240
RATE_LIMIT_WRITE_PER_MIN=60
RATE_LIMIT_HEAVY_PER_MIN=10
RATE_LIMIT_AUTH_PER_MIN=10

# ── Concurrency (L4) — DOCUMENTATION.md §8.3 ─────────────────────────────
HEAVY_CONCURRENCY_GLOBAL=3
HEAVY_CONCURRENCY_PER_USER=1
HEAVY_ACQUIRE_TIMEOUT_S=5.0
# AnyIO worker-thread ceiling. Most endpoints are sync `def` and run here;
# this workload is mostly waiting on SQLite, not CPU-bound, so a higher
# ceiling than the framework's default (40) is deliberate, not a mistake.
THREADPOOL_MAX=64

# ── Request size caps ─────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=10485760
MAX_REQUEST_BYTES=33554432
MAX_IMPORT_BYTES=52428800
