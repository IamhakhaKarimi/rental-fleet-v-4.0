{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "api.main:app", "--port", "8001", "--host", "127.0.0.1"],
      "cwd": "backend",
      "port": 8001
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "frontend",
      "port": 3000
    },
    {
      "//": "Second dev server on 3010 so verification never has to stop the user's own next start on 3000.",
      "name": "frontend-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "dev", "-p", "3010"],
      "cwd": "frontend",
      "port": 3010
    }
  ]
}
