# Backend environment. Copy to `.env` (gitignored) at the repo root and fill in.
# Local dev: leave DATABASE_URL empty to use the bundled SQLite fleet.db.

# Empty => local SQLite (dev). Production: your Neon Postgres connection string.
# e.g. DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb
DATABASE_URL=

# Sign the session JWT. MUST be a long random secret in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_DAYS=14

# Session cookie. In production (HTTPS) set COOKIE_SECURE=true. Use SAMESITE=none
# (with SECURE=true) only if the frontend and API are on different sites.
COOKIE_NAME=bcr_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Comma-separated list of allowed frontend origins (the Next.js app).
CORS_ORIGINS=http://localhost:3000
